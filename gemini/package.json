{
  "name": "chimera-voice",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run wasm && vite --host 127.0.0.1",
    "build": "bun run wasm && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "bun run wasm && cargo test --workspace && bun test ./tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "timbre:render": "bun tools/render-timbres.ts",
    "timbre:test": "bun tools/timbre-e2e.ts",
    "lint:layout": "bun run wasm && bun tools/layout-lint.ts",
    "wasm": "bun tools/build-wasm.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.2.1",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
